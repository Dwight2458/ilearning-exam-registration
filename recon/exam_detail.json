"dayStartTime":null,"actualValue":0,"remainingValue":1}],"userGoingExamResultId":null,"examResultId":null,"examResultCreatedTime":null,"sessionUserIds":null,"addUserIds":null,"removeUserIds":null,"categoryList":null,"passStatus":null,"examIntroduction":"<p style=\"line-height: 2;\"><strong>1、考生工位信息补充反馈：<span style=\"color: #2e2e2e;\"><a style=\"color: #2e2e2e;\" href=\"https://isurvey.huawei.com/survey/#/privacy-page?p=L5fb3b-UwCl5s-1p9ImS\">https://isurvey.huawei.com/survey/#/privacy-page?p=L5fb3b-UwCl5s-1p9ImS</a></span></strong></p>\n<p style=\"line-height: 2;\">2、请<strong><span style=\"color: #e03e2d;\">选择工作中使用的编程语言</span></strong>进行认证，根据个人情况选择合适的认证级别（<strong><span style=\"color: #e03e2d;\">新员工不建议直接挑战专业级</span></strong>），准备充分再参加认证，优先满足个人持证上岗的需要。</p>\n<table width=\"379\">\n<tbody>\n<tr>\n<td width=\"379\">&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p><strong>注意事项：</strong></p>\n<p>1、<strong>上机编程科目FAQ(ilearning)</strong>：<span style=\"color: #2e2e2e;\"><a style=\"color: #2e2e2e;\" href=\"http://3ms.huawei.com/km/groups/3803117/blogs/details/7878885?l=zh-cn\">http://3ms.huawei.com/km/groups/3803117/blogs/details/7878885?l=zh-cn</a></span></p>\n<p>2、进入考试页面后，发现&ldquo;<span style=\"color: #e03e2d;\"><strong>考试资格受限</strong></span>&rdquo;，请您和<span style=\"color: #e03e2d;\"><strong>产品线接口人</strong></span>（<a href=\"http://3ms.huawei.com/km/groups/3803117/blogs/details/7879869?l=zh-cn\">点击链接查询</a>）确认是否属于认证目标人群。</p>\n<p>3、考试需要使用的浏览器为Google Chrome，版本为42以上。</p>\n<p>4、根据《公司内软件开发能力认证开展细则》，报名截止（<span style=\"color: #e03e2d;\">认证开始前2个工作日18:00&nbsp;比如：认证时间7月23日，报名截止时间为7月21日18:00</span>）后不接受认证变更和取消操作。如果需要取消/变更，请在报名截止前到<strong><span style=\"color: #e03e2d;\">&ldquo;iLearning个人中心&rdquo;&nbsp;&nbsp;-&ldquo;我的考试&rdquo; -&ldquo;已预约&rdquo;</span></strong>栏目中进行线上操作。如果未在指定地点进行认证，本次认证成绩无效，计入认证次数，三个月内不允许参加本科目认证；若经过调查确认存在恶意违规行为，按作弊处理。</p>\n<p>5、<strong><span style=\"color: #e03e2d;\">考试期间仅允许使用一个显示器</span>。</strong>若使用多个显示器将无法进入考试；考试过程中，使用多个显示器，系统将自动提交试卷。<br />关闭多余的显示器有三种方法：①拔掉显示器数据连接线；②断开显示器电源；③进入Windows操作系统【桌面】-&gt;【显示设置】-&gt;【多显示器】配置成&ldquo;复制这些显示器&rdquo;。<br />注意：仅关闭显示器的电源开关键，系统仍然会判定使用多显示器。</p>","subjectNums":null,"examInfoStatus":1,"userExamStatus":1,"createdByName":null,"modifiedByName":null,"ownerUserName":"杨金兰 84298454","maxScore":null,"isScoring":null,"sessionList":null,"sessionIds":null,"countdown":0,"examNotice":"<p style=\"text-align: center;\"><span style=\"font-size: 14pt;\"><strong>华为研发人员专业技术能力认证纪律要求承诺书</strong></span></p>\n<p>&nbsp;</p>\n<p style=\"margin: 2.25pt 0cm; line-height: 2;\"><span style=\"font-size: 12pt;\">根据华为人力资源<span lang=\"EN-US\">GPO</span>业务规定【<span lang=\"EN-US\">2025</span>】<span lang=\"EN-US\">001</span>号《人力资源流程业务违规问责定级标准》，<span style=\"color: #e03e2d;\"><strong>能力认证考试作弊基础定级为<span lang=\"EN-US\">2</span>级违规</strong></span>，可能面临降级、冻结晋升<span lang=\"EN-US\">/</span>涨薪、计入个人诚信档案等处罚。</span></p>\n<p style=\"line-height: 2;\"><span style=\"font-size: 12pt;\">为了维护认证的公平公正，我郑重承诺严格遵守认证纪律和合规要求：</span></p>\n<p style=\"line-height: 2;\">&nbsp; &nbsp; 1. 遵从公司安排在指定时间、指定地点参加认证，否则将视为考试违规行为；</p>\n<p style=\"line-height: 2;\">&nbsp; &nbsp; 2. 认证考试中独立完成答题，不发生以下违规行为：</p>\n<ul>\n<li>通过本地、<strong><span style=\"color: #e03e2d;\">网络（如代码仓、网络共享）、AI工具(如ChatGPT、CodeMate)</span></strong>等不当方式查看或获取考试相关的内容或答案；</li>\n<li>抄袭他人答案或有意让他人抄袭；</li>\n<li>携带与认证内容相关的资料或<strong><span style=\"color: #e03e2d;\">手机、智能手表等电子设备</span></strong>用于认证；</li>\n<li>由他人代替参加认证或者代替他人参加认证；</li>\n<li>认证过程中，向他人<strong><span style=\"color: #e03e2d;\">泄露题目</span></strong>，协助作弊；</li>\n<li>组织或协助多人考试作弊；</li>\n<li><span style=\"font-weight: 400;\">对考试系统/数据进行破坏或篡改</span>。</li>\n</ul>\n<p style=\"line-height: 2;\"><span style=\"font-size: 12pt;\">考试平台<span style=\"color: #e03e2d;\"><strong>已启用防违规功能</strong></span>，可有效识别本地/网上查资料、使用AI工具等违规行为，请严格遵守<span style=\"color: #1f1e1e;\"><a style=\"color: #1f1e1e;\" href=\"http://3ms.huawei.com/km/groups/3803117/blogs/details/10473777?l=zh-cn\"><span style=\"text-decoration: underline;\">《华为研发人员专业技术能力认证纪律要求》</span></a></span></span></p>","examCommitmentLetter":null,"examNoticeContentType":1,"examCommitmentLetterContentType":null,"examAfterExplainContentType":null,"nologinUserAttrList":null,"isReferences":null,"paperList":null,"labelIds":null,"isRetestExamFlag":1,"invitedLoginNumber":null,"attendedLoginNumber":null,"completedLoginNumber":null,"invitedNologinNumber":null,"attendedNologinNumber":null,"completedNologinNumber":null,"invitedNumber":0,"attendedNumber":0,"completedNumber":0,"timezoneName":"(UTC+08:00)北京、香港特别行政区、乌鲁木齐、吉隆坡、新加坡、台北","authCodeId":null,"isCredible":null,"examPaperList":null,"examUrl":null,"experimentConfigTaskId":null,"addressCode":null,"startAnswerTime":null,"endAnswerTime":null,"examCourseLinkList":null,"examManagerTeams":null,"isPassed":null,"guideContentType":null,"examGuidelines":null,"reservationLetterContentType":0,"reservationLetter":"<p style=\"text-align: center;\"><strong><span style=\"font-size: 18px;\">考前须知</span></strong></p>\n<p style=\"text-align: center;\"><strong><span style=\"font-size: 18px;\">&nbsp;</span></strong></p>\n<p style=\"text-align: center;\">请您在考试前反馈工位信息</p>\n<p style=\"text-align: center;\">（<span style=\"color: #e53333;\">提醒</span>：请您务必反馈，否则无法安排认证）</p>\n<p style=\"text-align: center;\"><a href=\"https://isurvey.huawei.com/survey/#/privacy-page?p=L5fb3b-UwCl5s-1p9ImS\" target=\"_blank\" rel=\"noopener\"><span style=\"color: #337fe5;\"><strong>去反馈</strong></span><strong>&gt;</strong></a></p>","userExamManagerRole":[],"examWhitelist":null,"taskUsers":null,"isUpdateTaskUser":null,"flowId":null,"reportExplainContentType":1,"reportExplain":"<table width=\"668\">\n<tbody>\n<tr>\n<td width=\"668\">科目一（上机编程）典型试题开放列表：<a href=\"http://3ms.huawei.com/km/groups/3803117/blogs/details/9606176?l=zh-cn\">http://3ms.huawei.com/km/groups/3803117/blogs/details/9606176?l=zh-cn</a></td>\n</tr>\n</tbody>\n</table>","fixedGroupPaper":null,"examNameOrExamCode":null,"againstCheatConfigList":null,"appProcessWhitelist":[],"urlWhitelist":[],"isRealSector":0,"appServiceSelectedList":null,"cl